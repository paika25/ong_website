# Variables d'environnement Supabase
# Récupérez ces valeurs depuis votre tableau de bord Supabase:
# https://app.supabase.com/project/_/settings/api

# URL de votre projet Supabase
NUXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co

# Clé publique anonyme (anon key)
NUXT_PUBLIC_SUPABASE_ANON_KEY=votre-anon-key-ici

# Note: Ces variables doivent commencer par NUXT_PUBLIC_ pour être accessibles côté client
