# Variables d'environnement pour Netlify
# Ces valeurs sont des exemples - configurez-les dans l'interface Netlify

# Base URL de l'application (utilisée pour les redirections Stripe après paiement)
NUXT_PUBLIC_APP_URL=https://votre-site.netlify.app

# Variables API (si vous avez des clés API externes)
# NUXT_PUBLIC_API_KEY=your-api-key-here

# Mode de build
NODE_ENV=production
