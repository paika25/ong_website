# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Récupérez ces valeurs depuis votre tableau de bord Supabase:
# https://app.supabase.com/project/_/settings/api

# URL de votre projet Supabase (Project URL)
NUXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Clé publique anonyme (anon/public key) — JWT requis par supabase-js
NUXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Clé service role (Settings > API > service_role — ne jamais exposer côté client)
NUXT_SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ============================================
# STRIPE (Sandbox)
# ============================================
# Récupérez ces valeurs sur https://dashboard.stripe.com/test/apikeys
NUXT_STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
NUXT_STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# URL de l'app pour les redirections Stripe (après paiement)
NUXT_PUBLIC_APP_URL=http://localhost:3000